{
  "name": "home-tka",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test --experimental-test-isolation=none tests/*.test.ts",
    "test:react": "node --import tsx --test --experimental-test-isolation=none tests/*.test.tsx",
    "check": "npm test && npm run test:react && npm run build"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~7.0.2",
    "tsx": "^4.20.6",
    "vite": "^7.1.12"
  }
}
