kernel.example.com {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }

    @api path /api /api/*
    @private path /.env /.env.* /.git /.git/* /data /data/* /backups /backups/* /kernel /kernel/* /backend /backend/*
    @database path_regexp database (?i)[.](sqlite3?|db)(-(wal|shm|journal))?$

    route {
        handle @api {
            reverse_proxy 127.0.0.1:8000
        }
        handle @private {
            respond 404
        }
        handle @database {
            respond 404
        }
        handle /assets/* {
            root * /var/www/kernel/current
            header Cache-Control "public, max-age=31536000, immutable"
            file_server
        }
        handle {
            root * /var/www/kernel/current
            header Cache-Control "no-cache"
            try_files {path} /index.html
            file_server
        }
    }
}
