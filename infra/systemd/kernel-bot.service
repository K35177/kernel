[Unit]
Description=kernel Telegram bot
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/kernel/production-approved
ConditionPathExists=/etc/kernel/polling-approved
RequiresMountsFor=/var/lib/kernel
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=kernel
Group=kernel
WorkingDirectory=/opt/kernel/current
EnvironmentFile=/etc/kernel/kernel.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
UMask=0077
StateDirectory=kernel
StateDirectoryMode=0700
RuntimeDirectory=kernel
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 75 /run/kernel/bot-polling.lock /opt/kernel/current/.venv/bin/python -u /opt/kernel/current/bot.py
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=2 75
TimeoutStopSec=60
KillMode=control-group
MemoryHigh=384M
MemoryMax=512M
TasksMax=128
LimitNOFILE=4096
LimitCORE=0
OOMPolicy=stop
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/kernel
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal
LogNamespace=kernel
SyslogIdentifier=kernel-bot
LogRateLimitIntervalSec=30
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
